    "db:seed": "npm run db:seed --workspace=packages/server"
  },
  "workspaces": [
    "packages/server",
    "packages/client"
  ],
  "keywords": [
    "workforce-management",
    "attendance",
    "geofence",
    "biometrics",
    "payroll",
    "scheduling"
  ],
