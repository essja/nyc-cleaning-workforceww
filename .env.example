# ==========================================
# WORKFORCE MANAGEMENT PLATFORM — ENVIRONMENT CONFIG
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (node:sqlite embedded speed for zero-config, or PostgreSQL)
DATABASE_FILE=./packages/server/workforce.db

# Authentication Secrets
JWT_SECRET=production_enterprise_jwt_secret_key_change_me_in_prod_2026
JWT_REFRESH_SECRET=production_enterprise_refresh_secret_key_change_me_in_prod_2026

# Geofence & Mobile Precision Defaults
DEFAULT_GEOFENCE_RADIUS_METERS=150
GPS_MAX_STALE_AGE_MS=30000

# Client App URL
CLIENT_URL=http://localhost:5173
